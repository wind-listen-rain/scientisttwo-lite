# 本机环境与第三方内容（由 setup.sh 重新获取）
.conda/
tasks/treehfd/
tasks/treehfd_paper.pdf
tasks/treehfd_paper.txt

# 工作区自己的版本历史（发布时以 HISTORY.bundle 形式附带）
.wsgit/

# 空跑产物（假智能体，可随时用 --dry-run 重新生成）
runs/dry/
runs_dry.log

# 缓存
__pycache__/
*.pyc
*.prof
tools/refcheck_cache.json
verify_cache.json
.DS_Store

# 本机控制文件：建了它编排器就会存档后停下（不同步到别的机器）
runs/*/STOP

# 智能体生成的中间缓存与数据转储：不进仓库（2026-09-29：E1 的缓存把工作区历史撑到 177 MB，推不上 GitHub）
runs/**/cache/
runs/**/*.npy
runs/**/*.npz
runs/**/*.pkl
runs/**/*.pt
runs/**/*.joblib
runs/**/HISTORY.bundle.tmp
